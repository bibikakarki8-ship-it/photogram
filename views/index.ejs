<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h2>Photogram</h2>
    <button type="button" class="btn btn-primary position-relative">
  Inbox
  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
    99+
    <span class="visually-hidden">unread messages</span>
  </span>
</button>
 <h1>post</h1>
    <div class="d-flex justify-content-end">
    <div class="form-check form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Switch On for Dark mode</label>
</div>
</div>








  








      

         <a class="btn btn-outline-info" href="http://localhost:3000/home/new">Create a new Post</a>



<div class="d-flex flex-wrap gap-3">
    <%for(post of posts){%>
  

   
<div class="card" style="width: 18rem;">
  <img src="<%=post.img%>" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title"></h5>
    <h4>Caption: <%=post.Caption%></h4> 
    <p>Likes:<%=post.like%></p>
    <p>Comment: <%=post.comment%></p>

         <div class="d-flex gap-2 mt-3" >
         <a class="btn btn-light action-btn " href="http://localhost:3000/home/<%=post.id %>" role="button">Show details</a> 
      
      <a class="btn btn-light edit-btn" href="http://localhost:3000/home/<%=post.id %>/edit">Edit</a>
      
      
   <form method="POST" action="/home/<%=post.id%>?_method=DELETE">
   <button type="submit" class="btn btn-danger ">Delete</button>
    
   </form>
    </div>

  </div>
</div>  

  <%}%> 
</div>
   








  <br>

  <br>
  

   <script src="app.js"></script>
    
</body>
</html>